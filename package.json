{
  "name": "@tacxou/cartulaire",
  "version": "0.0.1",
  "description": "Cartulaire — serveur d'identité open source OAuth 2.1 / OIDC first, orchestrant des microservices sécurisés.",
  "repository": "https://github.com/tacxou/cartulaire.git",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "license": "AGPL-3.0-only",
  "author": "Tacx <12997062+tacxou@users.noreply.github.com>",
  "contributors": [
    {
      "name": "tacxou",
      "email": "12997062+tacxou@users.noreply.github.com",
      "url": "https://github.com/tacxou"
    },
    {
      "name": "Contributors",
      "url": "https://github.com/tacxou/cartulaire/graphs/contributors"
    }
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "connectors/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "start:dev": "turbo run start:dev",
    "start:prod": "turbo run start:prod",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-config": "turbo run check-config",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "prepare": "husky",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3"
  }
}
