# ─── Cartulaire — variables d'environnement (exemple) ───────────────────────
# Copier en `.env` et adapter. Les secrets réels ne sont JAMAIS commités (§11).

# ── apps/api (cœur OIDC) ────────────────────────────────────────────────────
CARTULAIRE_LOG_LEVEL=debug
# memory = store en RAM (effacé à chaque redémarrage) ; redis = persistant
CARTULAIRE_STORAGE_ADAPTER=memory
# Utilisé uniquement si adapter=redis. Mettre l'IP/port de ton Redis ici.
CARTULAIRE_REDIS_URI=redis://localhost:6379
# CARTULAIRE_REDIS_PASSWORD=
# Doit inclure le préfixe /oidc (montage nest-oidc-provider) — discovery : {issuer}/.well-known/openid-configuration
CARTULAIRE_OIDC_ISSUER=http://localhost:9000/oidc
CARTULAIRE_OIDC_HOST=localhost
CARTULAIRE_OIDC_PORT=9000
CARTULAIRE_OIDC_PROTOCOL=http
CARTULAIRE_OIDC_COOKIE_KEYS=gQMQym96H64-QInq7mvVX0nZEw0qUmcTA3bCpfnuR1h3YXNhgGJ0XLd17obmV8Gm

# Secret partagé cœur (API) ↔ daemon, pour signer les commandes sortantes (§26.2)
CARTULAIRE_DAEMON_URL=http://localhost:8788/commands
CARTULAIRE_API_DAEMON_SECRET=change-me-api-daemon-secret-min-16

# ── apps/daemon (pont sécurisé) ─────────────────────────────────────────────
CARTULAIRE_DAEMON_PORT=8788
CARTULAIRE_DAEMON_LOG_LEVEL=debug
# Doit correspondre à CARTULAIRE_API_DAEMON_SECRET côté API
CARTULAIRE_DAEMON_INBOUND_SECRET=change-me-api-daemon-secret-min-16
CARTULAIRE_DAEMON_MAX_SKEW_MS=5000

# Connecteur mock déclaré côté daemon
CARTULAIRE_CONNECTOR_MOCK_URL=http://localhost:8443/commands
CARTULAIRE_CONNECTOR_MOCK_AUDIENCE=connector.mock
# Doit correspondre à MOCK_CONNECTOR_SECRET côté connecteur
CARTULAIRE_CONNECTOR_MOCK_SECRET=change-me-daemon-connector-secret-min-16
CARTULAIRE_CONNECTOR_MOCK_PERMISSIONS=identity.resolve,auth.verifyPassword,auth.getMfaMethods,auth.startMfa,auth.verifyMfa,auth.registerMfa,auth.disableMfa,claims.map,consent.get,consent.save,consent.revoke,session.revoke,admin.health

# ── connectors/mock ─────────────────────────────────────────────────────────
MOCK_CONNECTOR_PORT=8443
MOCK_CONNECTOR_AUDIENCE=connector.mock
MOCK_CONNECTOR_SECRET=change-me-daemon-connector-secret-min-16

# Debug oidc-provider
DEBUG=oidc-provider:*

# WebAuthn / passkeys (§23) — rpId = domaine, origin = URL exacte du navigateur
CARTULAIRE_WEBAUTHN_RP_ID=localhost
CARTULAIRE_WEBAUTHN_ORIGIN=http://localhost:9000

# Rate limiting (§37) — endpoints sensibles (login, token, device, userinfo)
CARTULAIRE_RATELIMIT_ENABLED=true
CARTULAIRE_TRUST_PROXY=false
CARTULAIRE_RATELIMIT_LOGIN_MAX=10
CARTULAIRE_RATELIMIT_LOGIN_WINDOW_MS=60000
CARTULAIRE_RATELIMIT_OAUTH_MAX=60
CARTULAIRE_RATELIMIT_OAUTH_WINDOW_MS=60000
