{% extends "layouts/main.njk" %}

{% block content %}
<div class="w-full max-w-md overflow-hidden rounded-[1.75rem] glass-shell">
  <div class="p-8 sm:p-10 lg:p-12 glass-inner backdrop-blur-sm">
    <div class="flex flex-col items-center mb-8">
      <img src="{{ branding.logo }}" width="112" height="112" alt="" decoding="async"
        class="w-20 h-20 object-contain select-none" />
      <h2 class="mt-6 text-2xl font-semibold tracking-tight text-zinc-50">Vérification en deux étapes</h2>
      <p class="mt-1.5 text-[15px] text-zinc-500 text-center">
        {{ mfa.hint | default("Entrez le code de votre second facteur.") }}
      </p>
    </div>

    {% if errorMessage %}
    <div class="mb-5 rounded-2xl border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-200">
      {{ errorMessage }}
    </div>
    {% endif %}

    {% if mfa.type == 'magic_link' %}
    <div class="text-center space-y-4">
      <div class="rounded-2xl border border-violet-400/30 bg-violet-500/10 px-4 py-5 text-[15px] text-zinc-200">
        Un lien de connexion vous a été envoyé par email.<br />Ouvrez-le sur cet appareil pour continuer.
      </div>
      <p class="text-[13px] text-zinc-500">{{ mfa.hint }}</p>
      <p class="text-center text-[13px] text-zinc-500 pt-2">
        <a href="/interaction/{{ uid }}/abort" class="link-accent font-medium transition">Annuler</a>
      </p>
    </div>
    {% elif mfa.type == 'webauthn' %}
    <form id="wa-form" action="/interaction/{{ uid }}" method="POST">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <input type="hidden" name="response" />
    </form>
    <script type="application/json" id="wa-options">{"publicKey": {{ mfa.options | dump | safe }}}</script>
    <button type="button" data-webauthn-authenticate
      class="btn-primary w-full rounded-full px-4 py-3.5 text-[15px] transition active:scale-[0.99]">
      Utiliser ma passkey
    </button>
    <p class="text-center text-[13px] text-zinc-500 pt-4">
      <a href="/interaction/{{ uid }}/abort" class="link-accent font-medium transition">Annuler</a>
    </p>
    <script src="/js/webauthn.js"></script>
    {% else %}
    <form action="/interaction/{{ uid }}" method="POST" autocomplete="off" class="space-y-5">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <input type="hidden" name="code" id="code" value="{{ form.code | default('') }}" />
      <div>
        <label for="otp-0" class="block text-[13px] font-medium text-zinc-400 mb-2">Code de vérification</label>
        <div class="grid grid-cols-6 gap-2 sm:gap-3" data-otp-inputs>
          {% for i in [0, 1, 2, 3, 4, 5] %}
          <input type="text" id="otp-{{ i }}" inputmode="numeric" autocomplete="one-time-code"
            pattern="[0-9A-Za-z]*" maxlength="1" required {% if i == 0 %}autofocus{% endif %}
            class="glass-field block w-full rounded-2xl px-0 py-3 text-center text-lg font-semibold tracking-normal placeholder:text-zinc-600 transition"
            data-otp-digit />
          {% endfor %}
        </div>
      </div>

      <button type="submit"
        class="btn-primary w-full rounded-full px-4 py-3.5 text-[15px] transition active:scale-[0.99]">
        Vérifier
      </button>

      <p class="text-center text-[13px] text-zinc-500 pt-2">
        <a href="/interaction/{{ uid }}/abort" class="link-accent font-medium transition">Annuler</a>
      </p>
    </form>
    <script nonce="{{ cspNonce }}">
      (() => {
        const hiddenInput = document.getElementById('code');
        const digits = Array.from(document.querySelectorAll('[data-otp-digit]'));
        if (!(hiddenInput instanceof HTMLInputElement) || digits.length === 0) return;

        const syncHiddenCode = () => {
          hiddenInput.value = digits.map((input) => input.value).join('');
        };

        const applyCode = (value) => {
          const normalized = value.replace(/[^0-9A-Za-z]/g, '').slice(0, digits.length);
          digits.forEach((input, index) => {
            input.value = normalized[index] ?? '';
          });
          syncHiddenCode();
        };

        applyCode(hiddenInput.value);

        digits.forEach((input, index) => {
          input.addEventListener('input', () => {
            const normalized = input.value.replace(/[^0-9A-Za-z]/g, '');
            if (normalized.length > 1) {
              applyCode(normalized);
              const nextFilledIndex = Math.min(normalized.length, digits.length - 1);
              digits[nextFilledIndex]?.focus();
              digits[nextFilledIndex]?.select();
              return;
            }

            input.value = normalized;
            syncHiddenCode();

            if (normalized && index < digits.length - 1) {
              digits[index + 1].focus();
              digits[index + 1].select();
            }
          });

          input.addEventListener('keydown', (event) => {
            if (event.key === 'Backspace' && !input.value && index > 0) {
              digits[index - 1].focus();
              digits[index - 1].select();
            }

            if (event.key === 'ArrowLeft' && index > 0) {
              event.preventDefault();
              digits[index - 1].focus();
              digits[index - 1].select();
            }

            if (event.key === 'ArrowRight' && index < digits.length - 1) {
              event.preventDefault();
              digits[index + 1].focus();
              digits[index + 1].select();
            }
          });

          input.addEventListener('focus', () => input.select());

          input.addEventListener('paste', (event) => {
            event.preventDefault();
            applyCode(event.clipboardData?.getData('text') ?? '');
            const firstEmpty = digits.findIndex((field) => !field.value);
            const focusIndex = firstEmpty === -1 ? digits.length - 1 : firstEmpty;
            digits[focusIndex]?.focus();
            digits[focusIndex]?.select();
          });
        });
      })();
    </script>
    {% endif %}
  </div>
</div>
{% endblock %}
