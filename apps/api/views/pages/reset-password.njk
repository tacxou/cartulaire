{% extends "layouts/main.njk" %}

{% block content %}
<div class="w-full max-w-md overflow-hidden rounded-[1.75rem] glass-shell">
  <div class="p-8 sm:p-10 lg:p-12 glass-inner backdrop-blur-sm">
    <div class="flex flex-col items-center text-center">
      <img src="{{ branding.logo }}" width="112" height="112" alt="{{ branding.appName }}" decoding="async"
        class="w-20 h-20 object-contain select-none" />
      <h1 class="mt-6 text-2xl font-semibold tracking-tight text-zinc-50">Nouveau mot de passe</h1>
      <p class="mt-2 text-[15px] leading-relaxed text-zinc-400">
        Choisissez un nouveau mot de passe pour votre compte.
      </p>
    </div>

    {% if error %}
    <div class="mt-6 rounded-2xl border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-200">
      {{ error }}
      {% if tokenInvalid %}
      <a href="/forgot-password" class="link-accent block mt-1 font-medium">Redemander un lien</a>
      {% endif %}
    </div>
    {% endif %}

    <form action="/reset-password" method="POST" autocomplete="off" class="mt-8 space-y-5">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <input type="hidden" name="token" value="{{ token }}" />
      <div>
        <label for="newPassword" class="block text-[13px] font-medium text-zinc-400 mb-2">Nouveau mot de passe</label>
        <input type="password" name="newPassword" id="newPassword" required minlength="8"
          class="glass-field block w-full rounded-2xl px-4 py-3 text-[15px] placeholder:text-zinc-600 transition" />
      </div>

      <div>
        <label for="confirmPassword" class="block text-[13px] font-medium text-zinc-400 mb-2">Confirmer le mot de passe</label>
        <input type="password" name="confirmPassword" id="confirmPassword" required minlength="8"
          class="glass-field block w-full rounded-2xl px-4 py-3 text-[15px] placeholder:text-zinc-600 transition" />
      </div>

      <button type="submit"
        class="btn-primary w-full rounded-full px-4 py-3.5 text-[15px] transition active:scale-[0.99]">
        Réinitialiser le mot de passe
      </button>
    </form>
  </div>
</div>
{% endblock %}
