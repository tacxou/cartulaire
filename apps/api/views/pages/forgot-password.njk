{% extends "layouts/main.njk" %}

{% block content %}
<div class="w-full max-w-md overflow-hidden rounded-[1.75rem] glass-shell">
  <div class="p-8 sm:p-10 lg:p-12 glass-inner backdrop-blur-sm">
    <div class="flex flex-col items-center text-center">
      <img src="{{ branding.logo }}" width="112" height="112" alt="{{ branding.appName }}" decoding="async"
        class="w-20 h-20 object-contain select-none" />
      <h1 class="mt-6 text-2xl font-semibold tracking-tight text-zinc-50">Mot de passe oublié</h1>
      <p class="mt-2 text-[15px] leading-relaxed text-zinc-400">
        Indiquez votre identifiant : si un compte existe, un lien de réinitialisation vous sera envoyé.
      </p>
    </div>

    {% if error %}
    <div class="mt-6 rounded-2xl border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-200">
      {{ error }}
    </div>
    {% endif %}

    <form action="/forgot-password" method="POST" autocomplete="off" class="mt-8 space-y-5">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <div>
        <label for="identifier" class="block text-[13px] font-medium text-zinc-400 mb-2">Identifiant</label>
        <input type="text" name="identifier" id="identifier" required
          class="glass-field block w-full rounded-2xl px-4 py-3 text-[15px] placeholder:text-zinc-600 transition" />
      </div>

      <button type="submit"
        class="btn-primary w-full rounded-full px-4 py-3.5 text-[15px] transition active:scale-[0.99]">
        Envoyer le lien de réinitialisation
      </button>
    </form>

    <div class="mt-6 flex flex-col gap-3">
      <a href="/" class="btn-glass inline-flex items-center justify-center rounded-full px-4 py-3 text-[14px] transition">
        Retour à l'accueil
      </a>
    </div>
  </div>
</div>
{% endblock %}
