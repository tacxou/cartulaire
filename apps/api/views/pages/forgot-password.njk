{% extends "layouts/main.njk" %}

{% block content %}
<div class="w-full max-w-md overflow-hidden rounded-[1.75rem] glass-shell">
  <div class="p-8 sm:p-10 lg:p-12 glass-inner backdrop-blur-sm">
    <div class="flex flex-col items-center text-center">
      <img src="{{ branding.logo }}" width="112" height="112" alt="{{ branding.appName }}" decoding="async"
        class="w-20 h-20 object-contain select-none" />
      <h1 class="mt-6 text-2xl font-semibold tracking-tight text-zinc-50">Mot de passe oublié</h1>
      <p class="mt-2 text-[15px] leading-relaxed text-zinc-400">
        La récupération de mot de passe n'est pas encore disponible sur cette instance.
      </p>
    </div>

    <div class="mt-8 rounded-2xl border border-violet-400/20 bg-violet-500/10 px-4 py-4 text-sm text-zinc-200">
      Contactez l'administrateur ou revenez à l'écran de connexion pour réessayer avec un autre compte.
    </div>

    <div class="mt-6 flex flex-col gap-3">
      <a href="javascript:history.back()"
        class="btn-primary inline-flex items-center justify-center rounded-full px-4 py-3.5 text-[15px] transition active:scale-[0.99]">
        Retour à la connexion
      </a>
      <a href="/"
        class="btn-glass inline-flex items-center justify-center rounded-full px-4 py-3 text-[14px] transition">
        Aller à l'accueil
      </a>
    </div>
  </div>
</div>
{% endblock %}
