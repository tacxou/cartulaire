{% extends "layouts/main.njk" %}

{% block content %}
<div class="w-full max-w-md rounded-[1.75rem] glass-shell">
  <div class="p-8">
    <h1 class="text-xl font-semibold text-zinc-50">Annulation en cours</h1>
    <p class="mt-3 text-zinc-400 leading-relaxed">
      Refus de la demande et déconnexion en cours...
    </p>
    <p class="mt-4 text-[12px] text-zinc-500">
      Veuillez patienter quelques secondes.
    </p>
  </div>
</div>

<script>
  (function () {
    const abortCompleteUrl = '/interaction/{{ uid }}/abort/complete'
    const signOutUrl = '/interaction/{{ uid }}/abort/sign-out'

    window
      .fetch(abortCompleteUrl, { method: 'GET', credentials: 'include' })
      .then(function (res) {
        return res.json()
      })
      .then(function (body) {
        return window
          .fetch(body.resumeUrl, { method: 'GET', credentials: 'include', redirect: 'follow' })
          .then(function (res) {
            return res.url || body.fallbackRedirectUrl
          })
          .catch(function () {
            return body.fallbackRedirectUrl
          })
      })
      .then(function (clientUrl) {
        const dest = clientUrl
          ? signOutUrl + '?returnTo=' + encodeURIComponent(clientUrl)
          : signOutUrl
        window.location.assign(dest)
      })
      .catch(function () {
        window.location.assign(signOutUrl)
      })
  })()
</script>
{% endblock %}
