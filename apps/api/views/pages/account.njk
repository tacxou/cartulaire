{% extends "layouts/main.njk" %}

{% block content %}
<div class="w-full max-w-2xl overflow-hidden rounded-[1.75rem] glass-shell">
  <div class="p-8 sm:p-10 glass-inner backdrop-blur-sm">

    {% if not authenticated %}
      <div class="text-center">
        <img src="{{ branding.logo }}" width="96" height="96" alt="" class="mx-auto w-20 h-20 object-contain" />
        <h2 class="mt-6 text-2xl font-semibold text-zinc-50">Mon compte</h2>
        <p class="mt-3 text-[15px] text-zinc-500">Vous devez être connecté pour gérer votre compte.</p>
      </div>
    {% else %}
      <div class="flex items-center gap-4 mb-8">
        <img src="{{ branding.logo }}" width="56" height="56" alt="" class="w-12 h-12 object-contain" />
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-zinc-50">Mon compte</h2>
          <p class="mt-1 text-[13px] text-zinc-500">Identifiant : <span class="text-zinc-300">{{ sub }}</span></p>
        </div>
      </div>

      {% if enrolled %}
      <div class="mb-5 rounded-2xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200">
        Facteur ajouté avec succès.
      </div>
      {% endif %}
      {% if enrollError %}
      <div class="mb-5 rounded-2xl border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-200">
        {{ enrollError }}
      </div>
      {% endif %}

      <section class="mb-8">
        <h3 class="text-[13px] font-semibold uppercase tracking-wide text-zinc-400 mb-3">
          Vérification en deux étapes
        </h3>
        {% if methods and methods.length %}
        <ul class="space-y-2">
          {% for m in methods %}
          <li class="flex items-center justify-between rounded-2xl glass-field px-4 py-3">
            <span class="text-[15px] text-zinc-200">{{ m.label }} <span class="text-zinc-500 text-[13px]">({{ m.type }})</span></span>
            <form action="/account/mfa/remove" method="POST">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <input type="hidden" name="methodId" value="{{ m.id }}" />
              <button type="submit" class="text-[13px] text-red-300 hover:text-red-200 transition">Retirer</button>
            </form>
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="text-[14px] text-zinc-500">Aucun facteur configuré.</p>
        {% endif %}
      </section>

      {% if enrollment %}
      <section class="mb-2 rounded-2xl border border-violet-400/30 bg-violet-500/10 p-5">
        <h3 class="text-[15px] font-semibold text-zinc-100 mb-2">Nouveau facteur ({{ enrollment.type }})</h3>
        {% if enrollment.otpauthUri %}
        <p class="text-[13px] text-zinc-400 mb-1">Clé (à scanner dans votre application) :</p>
        <code class="block break-all text-[12px] text-violet-200 mb-3">{{ enrollment.secret }}</code>
        {% endif %}
        <p class="text-[13px] text-zinc-400 mb-3">{{ enrollment.hint }}</p>
        <form action="/account/mfa/confirm" method="POST" class="flex gap-3">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="hidden" name="type" value="{{ enrollment.type }}" />
          <input type="hidden" name="challengeId" value="{{ enrollment.challengeId }}" />
          <input type="text" name="code" inputmode="numeric" required autofocus placeholder="Code"
            class="glass-field flex-1 rounded-2xl px-4 py-2.5 text-center tracking-[0.2em]" />
          <button type="submit" class="btn-primary rounded-full px-5 py-2.5 text-[14px]">Confirmer</button>
        </form>
      </section>
      {% else %}
      <div class="flex flex-wrap gap-3">
        <form action="/account/mfa/enroll" method="POST" class="flex flex-wrap gap-3">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <button type="submit" name="type" value="totp"
            class="btn-primary rounded-full px-5 py-2.5 text-[14px]">Ajouter une app TOTP</button>
          <button type="submit" name="type" value="email_otp"
            class="rounded-full px-5 py-2.5 text-[14px] glass-field text-zinc-200 hover:text-white transition">Ajouter un code email</button>
        </form>
        <button type="button" data-webauthn-register
          class="rounded-full px-5 py-2.5 text-[14px] glass-field text-zinc-200 hover:text-white transition">Ajouter une passkey</button>
      </div>
      {% endif %}
    {% endif %}

  </div>
</div>
<meta name="csrf-token" content="{{ csrfToken }}" />
<script src="/js/webauthn.js"></script>
{% endblock %}
