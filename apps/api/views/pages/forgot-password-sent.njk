{% extends "layouts/main.njk" %}

{% block content %}
<div class="w-full max-w-md overflow-hidden rounded-[1.75rem] glass-shell">
  <div class="p-8 sm:p-10 lg:p-12 glass-inner backdrop-blur-sm">
    <div class="flex flex-col items-center text-center">
      <div class="flex h-16 w-16 items-center justify-center rounded-3xl border border-violet-400/25 bg-violet-500/10">
        {{ icon('mail', {class: 'h-8 w-8 text-violet-300'}) }}
      </div>
      <h1 class="mt-6 text-2xl font-semibold tracking-tight text-zinc-50">Vérifiez vos emails</h1>
      <p class="mt-2 text-[15px] leading-relaxed text-zinc-400">
        Si un compte correspond à cet identifiant, un lien de réinitialisation vient de lui être envoyé.
        Il expire dans 30 minutes.
      </p>
    </div>

    <div class="mt-8 flex flex-col gap-3">
      <a href="/" class="btn-primary inline-flex items-center justify-center rounded-full px-4 py-3.5 text-[15px] transition active:scale-[0.99]">
        Retour à l'accueil
      </a>
    </div>
  </div>
</div>
{% endblock %}
