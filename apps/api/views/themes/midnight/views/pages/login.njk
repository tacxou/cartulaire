{% extends "layouts/main.njk" %}

{% block content %}
<div class="crt-window">
  <div class="crt-titlebar">
    <span class="crt-titlebar__dot crt-titlebar__dot--active" aria-hidden="true"></span>
    <span class="crt-titlebar__dot" aria-hidden="true"></span>
    <span class="crt-titlebar__dot" aria-hidden="true"></span>
    <span class="ml-2">{{ branding.appName | lower }}.auth — session oidc</span>
  </div>

  <div class="crt-body">
    <p class="crt-prompt mb-1">init auth --provider oidc</p>
    <p class="text-[0.75rem] mb-6" style="color: var(--crt-dim);">
      // connexion requise · uid={{ uid }}
    </p>

    {% if errorMessage %}
    <div class="mb-5 border px-4 py-3 text-sm" style="border-color: #f87171; color: #fca5a5; background: rgba(248,113,113,.08);">
      [ERR] {{ errorMessage }}
    </div>
    {% endif %}

    <form action="/interaction/{{ uid }}" method="POST" autocomplete="off" class="space-y-5">
      <div>
        <label for="username" class="crt-label">identifiant</label>
        <input type="text" name="username" id="username" value="{{ form.username | default('') }}" required
          class="glass-field block w-full px-3 py-2.5 text-[14px] transition" placeholder="user@domain" />
      </div>

      <div>
        <label for="password" class="crt-label">mot_de_passe</label>
        <input type="password" name="password" id="password" required
          class="glass-field block w-full px-3 py-2.5 text-[14px] transition" placeholder="••••••••" />
      </div>

      <div class="flex justify-end">
        <a href="/forgot-password" class="link-accent text-[12px] transition">
          ./recover-password
        </a>
      </div>

      <div class="flex items-center gap-2 pt-1">
        <span class="crt-prompt">auth</span>
        <button type="submit"
          class="btn-primary flex-1 px-4 py-2.5 text-[12px] transition active:scale-[0.99]">
          [ENTER] connexion
        </button>
      </div>

      <p class="text-[12px] pt-2" style="color: var(--crt-dim);">
        pas de compte ?
        <a href="/register" class="link-accent transition">./register --new</a>
        <span class="crt-cursor ml-1" aria-hidden="true"></span>
      </p>
    </form>
  </div>
</div>
{% endblock %}
