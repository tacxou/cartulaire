<!DOCTYPE html>
<html lang="{{ prefs.defaultLanguage | default('fr') }}">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{% block title %}{{ branding.appName | default('Cartulaire') }}{% endblock %}</title>
  {% include "partials/assets/head.njk" %}
  {% include "partials/assets/theme.njk" %}
  {% block head_extra %}{% endblock %}
</head>

<body class="antialiased theme-body {% if fullWidth %}theme-body--full{% endif %}">
  {% if not fullWidth %}
  <div class="theme-auth-wrap">
    <div class="theme-auth-overlay" aria-hidden="true"></div>
    <div class="relative z-10 w-full flex justify-center">
  {% endif %}
      {% block content %}{% endblock %}
  {% if not fullWidth %}
    </div>
  </div>
  {% endif %}
  {% include "partials/assets/scripts.njk" %}
  {% include "partials/assets/theme-scripts.njk" %}
</body>
</html>
