{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "15",
  "globalDependencies": [
    "**/.env.*local",
    "tsconfig.base.json"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalPassThroughEnv": [
    "CARTULAIRE_*",
    "MOCK_*",
    "DEBUG",
    "NODE_TLS_REJECT_UNAUTHORIZED",
    "GIT_BRANCH",
    "GIT_COMMIT",
    "GIT_SHA",
    "GITHUB_REF_NAME",
    "GITHUB_SHA",
    "DOCKER_TAG",
    "IMAGE_TAG"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "start:dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start:prod": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start:debug": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "check-config": {
      "cache": false
    },
    "lint": {}
  }
}
